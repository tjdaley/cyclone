# Cyclone environment — template. Copy to .env and fill in. No real values here.
#
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE IS TESTED. tests/test_config_fingerprint.py builds a Settings from
# it and fails if it would not boot — because it did not. It listed
# SUPABASE_JWT_SECRET and SUPABASE_ANON_JWT_SECRET, which are not settings at
# all, and Settings sets `extra = "forbid"`. A node provisioned from this file
# died on import. The document whose whole job is preventing configuration
# mistakes was one.
#
# Every key below must be a field on Settings, and every credential must appear
# here — or provisioning a node silently omits it.
#
# ─────────────────────────────────────────────────────────────────────────────
# TWO SHAPES OF LINE, AND THE DIFFERENCE MATTERS.
#
#   <NAME>=           must be filled in.
#   # <NAME>=<value>  optional; the value shown is what applies when absent.
#                     Uncomment to override.
#
# Non-string settings are ALWAYS the commented shape, because an empty value is
# not a float, an int, a bool, or a JSON list, and pydantic refuses the entire
# file over a single one of them. That was the second thing wrong with this
# file: every numeric line was written blank and would have failed on first use.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE FOUR SECTIONS ARE NOT COSMETIC. They are the layers this configuration
# splits into, and they have different owners and lifetimes:
#
#   1. PER-NODE   differs per server, on purpose. Excluded from the fleet
#                 fingerprint — including it would make every pair of nodes
#                 disagree forever, and a drift check that always fires is one
#                 nobody reads.
#   2. FLEET      must be IDENTICAL on every node in an environment. This is
#                 where silent drift lives: a node running a different model
#                 temperature produces different evidence and says nothing.
#   3. SECRETS    credentials. Destined for SSM under an instance role, where
#                 the instance identity IS the credential and nothing is stored.
#   4. PER-FIRM   becomes a row in a `firms` table when a second firm is real.
#                 In the environment today, which is a single-tenant assumption
#                 compiled into the deployment.
#
# Check two running nodes agree, with no SSH and no credential:
#
#   curl -s https://a/api/config | jq -r .config_fingerprint.fleet_hash
#   curl -s https://b/api/config | jq -r .config_fingerprint.fleet_hash
#
# Different hashes mean drift. GET /api/v1/config/fingerprint (authenticated)
# says which setting, by digest, without printing any value.
# ─────────────────────────────────────────────────────────────────────────────


# ══ 1. PER-NODE ══════════════════════════════════════════════════════════════
# Expected to differ. Not fingerprinted.

# Which server answered. Shows in the UI and in Telegram escalations, and is how
# a report gets traced back to a machine. e.g. DEV, ec2-54-84-177-70
ID=
HOST_URL=

# Cyclone's own Supabase project.
SUPABASE_URL=

# The landing-pages project (read-only source of leads + attorneys).
SUPABASE_LANDING_PAGES_URL=

# Poller locks and inbound-email idempotency.
REDIS_URL=

# Where this node reads its SECRETS from. Omitted or anything else means "read
# this file, as before" -- so a laptop needs none of the three below.
#
# "ssm" reads them from AWS Parameter Store under an IAM instance role, with no
# stored credential: on EC2 the instance identity IS the credential. Nothing
# already set here is overwritten, which is what makes the cutover reversible in
# both directions -- turn it on and nothing changes until a line is deleted from
# this file; turn it off and this file takes over again.
# CYCLONE_SECRETS_SOURCE=ssm

# Which environment's parameters to read: /cyclone/<CYCLONE_ENV>/
#
# A FALLBACK, NOT THE PRIMARY PATH. The name comes from the EC2 instance tag
# `cyclone:environment` via instance metadata, set by provisioning at launch,
# and THE TAG WINS. Letting this variable win would put back the exact drift
# surface the tag removes -- a string typed by hand into a file on each box
# separately, which is how two nodes' .env files disagreed in the first place.
#
# Worth setting anyway: a tag that cannot be read is otherwise a hard failure
# (the loader refuses to guess and the container does not start), and with this
# set that degrades to a log line. The startup log says which path was taken.
# CYCLONE_ENV=production

# Region for the SSM call. Resolved by secret_source.region() and passed to
# boto3 explicitly, because botocore's own environment scan raised NoRegionError
# with this set and present in the process. Optional wherever instance metadata
# is reachable -- placement/region answers it with nobody typing anything.
# AWS_REGION=us-east-1


# ══ 2. FLEET ═════════════════════════════════════════════════════════════════
# Must match on every node in an environment. Fingerprinted.

LOG_LEVEL=
# IS_DEVELOPMENT=false

# Task-named profiles live in a JSON catalog, not here — app/config/llm_profiles.json.
LLM_PROFILES_FILE=
# LLM_TEMPERATURE=0.1
# LLM_TOP_P=0.1
# LLM_MAX_TOKENS=16384

# Per-call ceiling. Keep >= 10; Gemini rejects shorter deadlines. A deadline too
# short for the work silently selects for the model that gives up soonest.
# LLM_TIMEOUT_SECONDS=90.0

GROQ_BASE_URL=
DEEPSEEK_BASE_URL=

# Outbound mail.
SMTP_HOST=
SMTP_USERNAME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# SMTP_PORT=587
# SMTP_USE_TLS=true

# Inbound mail — one shared intake mailbox.
IMAP_HOST=
IMAP_USERNAME=
IMAP_MAILBOX=
IMAP_SPAM_FOLDER=
# IMAP_PORT=993

# Seconds to wait on a mail server, IMAP and SMTP alike. Without one the socket
# default is *never*, and the CRM tick holds a fleet-wide lock while it hangs.
# MAIL_TIMEOUT_SECONDS=30

# Seconds to wait on Redis, connecting and reading alike. Same argument as the
# mail timeout and the same fleet-wide lock at stake: the CRM tick holds
# crm:poller while it works, so one node hanging on Redis stops every node from
# polling. Bounds a HANG, not a refusal -- a refused connection already returns
# in about two seconds.
# REDIS_TIMEOUT_SECONDS=3.0

# Background worker. Jobs are polled fast because somebody is watching a
# spinner; concurrency trades against vendor rate limits, so lower it before
# raising it — a 429 fails over to the next model in the chain and quietly
# changes which model read the evidence.
# JOB_POLL_INTERVAL_SECONDS=3
# JOB_CONCURRENCY=5

# Largest file an upload accepts, in megabytes. MUST MATCH client_max_body_size
# in frontend/nginx.conf, which is where it is actually enforced; a test fails
# if they disagree. Bounded by memory, not preference -- uploads are read whole
# into RAM.
# MAX_UPLOAD_MB=128

# CRM poller. WELCOME_LEADS_AFTER is an ISO timestamp: only leads created at or
# after it are eligible for the automated welcome, so the back catalogue is
# never emailed. Empty disables welcomes entirely.
WELCOME_LEADS_AFTER=
# LEAD_POLL_INTERVAL_SECONDS=60


# ══ 3. SECRETS ═══════════════════════════════════════════════════════════════
# Fingerprinted by digest — never by value. Two nodes can be shown to hold the
# same key without the key appearing anywhere.
#
# SUPABASE KEY FORMAT — there is a deadline. The legacy `anon` and
# `service_role` JWT keys are retired by Supabase at the end of 2026. The
# replacements are `sb_secret_...` and `sb_publishable_...`, and they are
# created and revoked individually, where rotating service_role today means
# rotating the project JWT secret and invalidating everything signed with it.
#
# The migration is a change of VALUE in the same variable, not a rename:
# db_handler's SupabaseManager reads SUPABASE_SERVICE_ROLE_KEY out of the
# environment itself, and nothing in this codebase parses an API key as a JWT.
# Both key systems run in parallel, so the swap is reversible. Startup logs a
# warning — with days remaining — for any key still in the old format.

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LANDING_PAGES_SERVICE_ROLE_KEY=

# LLM vendors. A vendor with no key is skipped without being called, so an
# unused one can stay empty. DeepSeek is in no chain and must not be added to
# one that touches evidence — it mis-stated amounts and invented JSON keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The mailbox credentials deserve separate handling wherever the rest ends up:
# in a law firm that mailbox holds privileged communications, and it is the one
# credential whose compromise is a notification event rather than an
# inconvenience. Dedicated app password, its own rotation.
SMTP_PASSWORD=
IMAP_PASSWORD=

# Agent escalations to lead responders.
TELEGRAM_BOT_TOKEN=


# ══ 4. PER-FIRM ══════════════════════════════════════════════════════════════
# Becomes a `firms` row when a second firm exists. All of these are served from
# GET /api/config today — per process, where they need to be per request.

FIRM_NAME=

# Publishable, so it is safe to expose. Served to the frontend rather than baked
# into the build, so it can be rotated without a redeploy.
STRIPE_PUBLISHABLE_KEY=

# REFERRAL_TYPES=["attorney","former client","search","ai","other"]
# TIME_INCREMENT_OPTIONS=[0.1,0.25,0.5,1.0]
# DEFAULT_REFRESH_TRIGGER_PCT=0.40


# ══ READ BY docker-compose, NOT BY THE APP ═══════════════════════════════════
# Both are passed to the FRONTEND BUILD as VITE_* args. They are declared as
# Settings fields only because `extra = "forbid"` would otherwise refuse the
# line and stop the API container booting — API_BASE_URL was exactly that trap:
# docker-compose.yml already referenced it and nothing declared it.
#
# SUPABASE_ANON_KEY takes an `sb_publishable_...` value under the key migration
# above; supabase-js accepts it and the variable name does not change.
SUPABASE_ANON_KEY=
API_BASE_URL=
