# ─────────────────────────────────────────────
# Cyclone — Environment Variables Template
# Copy to .env and fill in values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────

# Application
FIRM_NAME=Your Law Firm
IS_DEVELOPMENT=false
HOST_URL=http://localhost:8000
# Which server instance is answering — shown in the UI / Telegram / logs.
# e.g. DEV, ec2-54-84-177-70
ID=local

# Logging
LOG_LEVEL=WARNING
# LOG_FORMAT=%(asctime)s - %(name)-15s - %(levelname)-8s - %(message)s

# ── Supabase (Cyclone primary DB) ─────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_ANON_JWT_SECRET=

# ── Supabase (Landing-pages DB — read-only source of leads) ──
SUPABASE_LANDING_PAGES_URL=
SUPABASE_LANDING_PAGES_SERVICE_ROLE_KEY=
SUPABASE_LANDING_PAGES_ANON_KEY=

# ── LLM: vendor credentials ───────────────────
# Credentials only — which models get used is decided by the profiles below.
GEMINI_API_KEY=

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── LLM: profiles ─────────────────────────────
# Callers name a TASK ("analyze_pleading"), and the catalog file maps that task
# to an ordered chain of vendor+model candidates. Retuning which models serve a
# task is an edit to that file — no code change, no key sprawl here.
# Relative paths resolve against the app/ package directory.
LLM_PROFILES_FILE=config/llm_profiles.json

# Global sampling defaults (profiles and candidates may override individually)
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.1
LLM_MAX_TOKENS=16384
# Per-call ceiling in seconds. A hung vendor otherwise hangs the whole request
# and failover never fires, since failover is triggered by an exception.
# Keep at or above 10 — Gemini rejects shorter deadlines.
LLM_TIMEOUT_SECONDS=90

# ── Billing ───────────────────────────────────
# TIME_INCREMENT_OPTIONS=[0.1, 0.25, 0.5, 1.0]
# DEFAULT_REFRESH_TRIGGER_PCT=0.40

# ── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Email: SMTP (outbound) + IMAP (inbound) ───
# One shared intake mailbox the CRM agent owns.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Cyclone Intake

IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SPAM_FOLDER=Spam

# ── Telegram (agent escalations) ──────────────
TELEGRAM_BOT_TOKEN=

# ── Redis / Valkey (poller locks + dedup) ─────
REDIS_URL=redis://localhost:6379/0

# ── CRM agent poller ──────────────────────────
LEAD_POLL_INTERVAL_SECONDS=60
# How often the worker looks for queued background jobs (matter intake).
# Short — an attorney is watching a spinner while extraction runs.
JOB_POLL_INTERVAL_SECONDS=3
# Set to the go-live timestamp (ISO 8601) so existing leads are never
# auto-welcomed. Empty disables welcomes. e.g. 2026-06-01T00:00:00+00:00
WELCOME_LEADS_AFTER=

# ── Frontend (Vite build-time) ────────────────
# These go in .env.frontend (or frontend/.env)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL=http://localhost:8000
# VITE_STRIPE_PUBLISHABLE_KEY=
