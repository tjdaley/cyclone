# config/environments/dev.env — non-secret, development-wide.
#
# COMMITTED. The dev compose override already sets IS_DEVELOPMENT and LOG_LEVEL
# per service; this file is what a dev node uses when it is NOT running under
# docker-compose.override.yml — a laptop running uvicorn directly, or a shared
# staging box.
IS_DEVELOPMENT=true
LOG_LEVEL=DEBUG
